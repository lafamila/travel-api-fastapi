# Local/dev defaults for the independently deployed travel API.
# Reuse shared root infra when available, or replace these values with managed infra in deployment.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travelnote

S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_BASE_URL=http://localhost:4566
S3_BUCKET_NAME=teddy-travel-media
S3_REGION=ap-northeast-2

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2

LOCALSTACK_STATE_URL=http://localhost:4566
S3_SAVE_STATE_AFTER_UPLOAD=0
S3_STATE_SAVE_STRICT=0
