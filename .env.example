# Local/dev defaults for the independently deployed travel API.
# Reuse shared root infra when available, or replace these values with managed infra in deployment.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travelnote

AUTH_ISSUER_URL=http://localhost:3032
AUTH_API_BASE_URL=http://localhost:3032
AUTH_JWKS_URL=http://localhost:3032/oauth/jwks
AUTH_AUDIENCE=service:travel
AUTH_JWKS_CACHE_SECONDS=300

TRAVEL_ALLOWED_ORIGINS=http://localhost:3043,http://127.0.0.1:3043,https://map.lafamila.xyz
TRAVEL_WEB_BASE_URL=http://localhost:3043
TRAVEL_OIDC_CLIENT_ID=travel-api
TRAVEL_OIDC_CLIENT_SECRET=
TRAVEL_OIDC_REDIRECT_URI=http://localhost:8010/api/session/oidc/callback
TRAVEL_SESSION_COOKIE_NAME=teddy_travel_session
TRAVEL_SESSION_COOKIE_SECURE=false
TRAVEL_SESSION_COOKIE_SAMESITE=lax
TRAVEL_SESSION_COOKIE_DOMAIN=
TRAVEL_SESSION_MAX_AGE_SECONDS=604800

AUTH_SERVICE_KEY_ID=
AUTH_SERVICE_SECRET=
TRAVEL_LEGACY_OWNER_LOGIN_ID=lafamila
TRAVEL_ENABLE_PLAYWRIGHT_FALLBACK=false

# Storage provider. Local development keeps LocalStack; production uses `r2`.
STORAGE_BACKEND=localstack
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_BASE_URL=http://localhost:4566
S3_BUCKET_NAME=teddy-travel-media
S3_REGION=ap-northeast-2
S3_AUTO_CREATE_BUCKET=true
S3_SIGNED_URL_TTL_SECONDS=600

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2

# LocalStack-only persistence settings. Keep disabled for R2.
LOCALSTACK_STATE_URL=http://localhost:4566
S3_SAVE_STATE_AFTER_UPLOAD=0
S3_STATE_SAVE_STRICT=0
TRAVEL_MEDIA_TEMPORARY_TTL_HOURS=24

# Production R2 example:
# STORAGE_BACKEND=r2
# S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=
# S3_BUCKET_NAME=teddy-travel-prod
# S3_REGION=auto
# S3_AUTO_CREATE_BUCKET=false
# S3_SIGNED_URL_TTL_SECONDS=600
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# AWS_DEFAULT_REGION=auto
# S3_SAVE_STATE_AFTER_UPLOAD=0
# S3_STATE_SAVE_STRICT=0

# Photo import API + separate `python -m src.import_worker` process.
# Local imports stay disabled while either local path is blank.
TRAVEL_IMPORT_LOCAL_ROOT=
TRAVEL_IMPORT_OUTPUT_ROOT=
TRAVEL_IMPORT_PUBLISH_ENABLED=false
TRAVEL_IMPORT_MAX_UPLOAD_BYTES=2147483648
TRAVEL_IMPORT_MAX_ZIP_FILES=2000
TRAVEL_IMPORT_MAX_ZIP_EXPANDED_BYTES=10737418240
TRAVEL_IMPORT_JOB_STALE_SECONDS=900
TRAVEL_IMPORT_WORKER_POLL_SECONDS=2
TRAVEL_IMPORT_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
TRAVEL_IMPORT_NOMINATIM_USER_AGENT=teddy-travel-import/1.0 (https://map.lafamila.xyz)
